<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--              AI GENERATE WIZARD — FORM VIEW                   -->
    <!-- ============================================================ -->

    <record id="kms_ai_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">kms.ai.generate.wizard.form</field>
        <field name="model">kms.ai.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Content Generator">
                <field name="state" invisible="1"/>

                <!-- ========== UPLOAD STATE ========== -->
                <div invisible="state != 'upload'">
                    <div class="alert alert-info mb-3" role="status">
                        <i class="fa fa-magic"/> Upload a PDF document and let AI generate
                        knowledge nodes with flashcards and quiz questions from your source material.
                    </div>
                    <group>
                        <group string="Source Document">
                            <field name="source_file" filename="source_filename"
                                   widget="binary" required="state == 'upload'"
                                   accept="application/pdf"/>
                            <field name="source_filename" invisible="1"/>
                        </group>
                        <group string="Options">
                            <field name="course_id"/>
                            <field name="num_flashcards"/>
                            <field name="num_questions"/>
                        </group>
                    </group>
                </div>

                <!-- ========== PREVIEW STATE ========== -->
                <div invisible="state != 'preview'">
                    <div class="alert alert-warning mb-3" role="status">
                        <i class="fa fa-eye"/> Review the generated content below.
                        Uncheck items you don't want to create, then click
                        <strong>Confirm &amp; Create</strong>.
                    </div>
                    <notebook>
                        <!-- Nodes tab -->
                        <page string="Nodes" name="preview_nodes">
                            <field name="node_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="flashcard_count" string="# FC"/>
                                    <field name="question_count" string="# Q"/>
                                </list>
                            </field>
                        </page>

                        <!-- Flashcards tab -->
                        <page string="Flashcards" name="preview_flashcards">
                            <field name="flashcard_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="node_name"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="front"/>
                                    <field name="back"/>
                                </list>
                            </field>
                        </page>

                        <!-- Questions tab -->
                        <page string="Questions" name="preview_questions">
                            <field name="question_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="node_name"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_text"/>
                                    <field name="question_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </div>

                <!-- ========== DONE STATE ========== -->
                <div invisible="state != 'done'">
                    <field name="status_message" nolabel="1" class="w-100"/>
                    <div class="text-center mt-3">
                        <button name="action_view_nodes" type="object"
                                string="View Created Nodes"
                                class="btn-primary"
                                icon="fa-external-link"/>
                    </div>
                </div>

                <!-- ========== FOOTER ========== -->
                <footer>
                    <button name="action_generate" type="object"
                            string="🤖 Generate" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_back" type="object"
                            string="← Back"
                            invisible="state != 'preview'"/>
                    <button name="action_confirm" type="object"
                            string="✓ Confirm &amp; Create" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    WIZARD ACTION                              -->
    <!-- ============================================================ -->

    <record id="kms_ai_generate_wizard_action" model="ir.actions.act_window">
        <field name="name">AI Generate Content</field>
        <field name="res_model">kms.ai.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
