<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Course Search View -->
    <record id="kms_course_view_search" model="ir.ui.view">
        <field name="name">kms.course.view.search</field>
        <field name="model">kms.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name"/>
                <field name="instructor_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Instructor" name="group_instructor" context="{'group_by': 'instructor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Course Tree/List View -->
    <record id="kms_course_view_list" model="ir.ui.view">
        <field name="name">kms.course.view.list</field>
        <field name="model">kms.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="instructor_id"/>
                <field name="node_count"/>
                <field name="learner_count"/>
            </list>
        </field>
    </record>

    <!-- Course Form View -->
    <record id="kms_course_view_form" model="ir.ui.view">
        <field name="name">kms.course.view.form</field>
        <field name="model">kms.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(kms_mastery.kms_node_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                domain="[('id', 'in', node_ids)]">
                            <field name="node_count" widget="statinfo" string="Nodes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Python Fundamentals"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="instructor_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview" name="overview">
                            <field name="description" placeholder="Course overview and description..."/>
                        </page>
                        <page string="Knowledge Nodes" name="nodes">
                            <field name="node_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Enrolled Learners" name="learners">
                            <field name="learner_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="instructor_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Course Kanban View -->
    <record id="kms_course_view_kanban" model="ir.ui.view">
        <field name="name">kms.course.view.kanban</field>
        <field name="model">kms.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="instructor_id"/>
                <field name="node_count"/>
                <field name="learner_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                Instructor: <field name="instructor_id"/>
                            </div>
                            <div class="row mt-2">
                                <div class="col-6">
                                    <span class="badge text-bg-primary">
                                        <field name="node_count"/> Nodes
                                    </span>
                                </div>
                                <div class="col-6">
                                    <span class="badge text-bg-success">
                                        <field name="learner_count"/> Learners
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Course Action -->
    <record id="kms_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">kms.course</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="kms_course_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course
            </p>
            <p>
                Courses group knowledge nodes into structured learning paths
                with enrolled learners and milestone assessments.
            </p>
        </field>
    </record>

</odoo>
