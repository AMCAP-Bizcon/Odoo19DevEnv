<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                      TOP-LEVEL APP MENU                       -->
    <!-- ============================================================ -->

    <menuitem id="kms_root_menu"
              name="KMS Mastery"
              web_icon="kms_mastery,static/description/icon.png"
              sequence="100"/>

    <!-- ============================================================ -->
    <!--                    DAG VIEWER ACTIONS                         -->
    <!-- ============================================================ -->

    <!-- DAG Viewer Client Action (Full Graph) -->
    <record id="kms_dag_viewer_action" model="ir.actions.client">
        <field name="name">Knowledge DAG</field>
        <field name="tag">kms_mastery.dag_viewer</field>
    </record>

    <!-- DAG Viewer Client Action (My Graph) -->
    <record id="kms_my_dag_viewer_action" model="ir.actions.client">
        <field name="name">My Knowledge DAG</field>
        <field name="tag">kms_mastery.dag_viewer</field>
        <field name="params" eval="{'my_nodes_only': True}"/>
        <field name="context">{'my_nodes_only': True}</field>
    </record>

    <!-- ============================================================ -->
    <!--                       COURSES MENUS                           -->
    <!-- ============================================================ -->

    <menuitem id="kms_courses_menu"
              name="Courses"
              parent="kms_root_menu"
              sequence="10"/>

    <menuitem id="kms_my_courses_menu"
              name="My Courses"
              parent="kms_courses_menu"
              action="kms_my_course_action"
              sequence="10"/>

    <menuitem id="kms_all_courses_menu"
              name="All Courses"
              parent="kms_courses_menu"
              action="kms_course_action"
              sequence="20"/>

    <!-- ============================================================ -->
    <!--                   KNOWLEDGE GRAPH MENUS                       -->
    <!-- ============================================================ -->

    <menuitem id="kms_dag_menu"
              name="Knowledge Graph"
              parent="kms_root_menu"
              sequence="20"/>

    <menuitem id="kms_my_dag_menu"
              name="My Graph"
              parent="kms_dag_menu"
              action="kms_my_dag_viewer_action"
              sequence="10"/>

    <menuitem id="kms_full_dag_menu"
              name="Full Graph"
              parent="kms_dag_menu"
              action="kms_dag_viewer_action"
              sequence="20"/>

    <!-- ============================================================ -->
    <!--                 PERFORMANCE REPORTS MENUS                     -->
    <!-- ============================================================ -->

    <menuitem id="kms_reports_menu"
              name="Performance Reports"
              parent="kms_root_menu"
              sequence="30"/>

    <menuitem id="kms_quiz_attempts_menu"
              name="Quiz Attempts"
              parent="kms_reports_menu"
              action="kms_quiz_attempt_action"
              sequence="10"/>

    <menuitem id="kms_milestone_submissions_menu"
              name="Milestone Submissions"
              parent="kms_reports_menu"
              action="kms_user_milestone_action"
              sequence="20"/>

</odoo>
