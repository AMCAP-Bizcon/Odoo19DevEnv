              sequence="10"/>

    <menuitem id="kms_instructor_courses_menu"
              name="Courses"
              parent="kms_instructor_menu"
              action="kms_course_action"
              sequence="10"/>

    <menuitem id="kms_instructor_nodes_menu"
              name="Knowledge Nodes"
              parent="kms_instructor_menu"
