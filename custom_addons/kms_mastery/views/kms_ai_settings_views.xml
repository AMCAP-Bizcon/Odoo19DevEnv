<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kms_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kms.mastery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="KMS Mastery" string="KMS Mastery" name="kms_mastery" data-key="kms_mastery" groups="kms_mastery.group_kms_admin">
                    <block title="AI Content Generation" name="kms_ai_settings">
                        <setting string="Gemini API Key"
                                 help="Configure your Google Gemini API key for AI-powered content generation from source material.">
                            <field name="kms_ai_api_key" password="True"/>
                        </setting>
                        <setting string="Gemini Model"
                                 help="The Gemini model used to generate nodes, flashcards, and quiz questions.">
                            <field name="kms_ai_model" placeholder="gemini-2.0-flash"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
